    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU (1.0 = one full core)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) ((rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\"}[5m]) * on (id) group_left (name) returnit_container_info{name=~\"returnit-prod-.*\"}))",
          "legendFormat": "{{name}}"
