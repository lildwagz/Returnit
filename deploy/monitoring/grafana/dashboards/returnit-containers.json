              "type": "value",
              "options": {
                "0": {
                  "text": "UNHEALTHY",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
