    {
      "id": 7,
      "type": "stat",
      "title": "Memory of all containers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum((container_memory_working_set_bytes{id=~\"/system.slice/docker-.*\"} * on (id) group_left (name) returnit_container_info{name=~\"returnit-prod-.*\"}))",
          "legendFormat": "__auto"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
