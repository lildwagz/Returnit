      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(returnit_container_healthy{name=~\"returnit-prod-.*\"} == 0) or vector(0)",
          "legendFormat": "__auto"
