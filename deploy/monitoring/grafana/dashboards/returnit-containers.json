    {
      "id": 12,
      "type": "bargauge",
      "title": "Memory against limit (limited containers)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (container_memory_working_set_bytes{id=~\"/system.slice/docker-.*\"} * on (id) group_left (name) returnit_container_info{name=~\"returnit-prod-.*\"}) / ((container_spec_memory_limit_bytes{id=~\"/system.slice/docker-.*\"} > 0 < 1e15) * on (id) group_left (name) returnit_container_info{name=~\"returnit-prod-.*\"})",
          "legendFormat": "{{name}}"
