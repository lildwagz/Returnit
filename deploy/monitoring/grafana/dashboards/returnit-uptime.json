    {
      "id": 5,
      "type": "table",
      "title": "Public (through Cloudflare, as users reach it)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (probe_success{job=~\"blackbox-(http|redirect|apk)\",name!=\"API (internal)\"}) + 0.5",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (probe_duration_seconds{job=~\"blackbox-(http|redirect|apk)\",name!=\"API (internal)\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (avg_over_time(probe_success{job=~\"blackbox-(http|redirect|apk)\",name!=\"API (internal)\"}[24h])) * 100",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (probe_success{job=~\"blackbox-(http|redirect|apk)\",name!=\"API (internal)\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) ((probe_ssl_earliest_cert_expiry{job=~\"blackbox-(http|redirect|apk)\",name!=\"API (internal)\"} - time()) / 86400)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
