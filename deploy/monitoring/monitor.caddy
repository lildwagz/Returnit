# monitor.<DOMAIN> -> Grafana, protected by Grafana's own login (and its brute-force lockout). Mounted into Caddy by
# docker-compose.monitoring.yml; the tunnel routes monitor.<DOMAIN> to http://caddy:8086 (HOME-SERVER.md section 10).
# For a second layer put Cloudflare Access in front of the hostname.
:8086 {
	import secure
	reverse_proxy grafana:3000
}
