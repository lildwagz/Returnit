# Caddy terminates HTTPS (certificates from Let's Encrypt, renewed automatically) and forwards to the
# private services. DOMAIN and ACME_EMAIL come from .env.prod.
{
	email {$ACME_EMAIL}
}

(secure) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# The mobile app talks to this.
api.{$DOMAIN} {
	import secure
	# Receipts are limited to 10 MiB by the API; this stops oversized bodies earlier.
	request_body {
		max_size 11MB
	}
	reverse_proxy web:8080
}

# Login server. Only the realm's public endpoints are reachable; the admin console and the master
# realm are not (use the SSH tunnel for administration).
auth.{$DOMAIN} {
	import secure
	# /realms/returnit/account is Keycloak's web page for users to edit their own profile. The app does not use it, and
	# a changed e-mail address there would not reach our database, so it stays closed.
	@private path /admin /admin/* /realms/master /realms/master/* /realms/returnit/account /realms/returnit/account/* /metrics /metrics/* /health /health/*
	respond @private 404
	reverse_proxy keycloak:8080
}

# The Android app (APK) and its download page. Only the page, the APK files and their checksums are served; latest.json
# (what the API tells the app) stays private. The files are put here by ./publish-apk.sh.
dl.{$DOMAIN} {
	import secure
	@notread not method GET HEAD
	respond @notread 405
	@public path / /index.html /returnit-*.apk /returnit-*.apk.sha256
	handle @public {
		root * /srv/updates
		@apk path *.apk
		header @apk Content-Disposition attachment
		header @apk Content-Type application/vnd.android.package-archive
		file_server
	}
	handle {
		respond 404
	}
}

# Receipt downloads. The app opens short-lived signed links here; the bucket itself stays private, so a
# request without a valid signature is refused by the storage server. Only reading is allowed.
files.{$DOMAIN} {
	import secure
	@notread not method GET HEAD
	respond @notread 405
	reverse_proxy minio:9000
}
