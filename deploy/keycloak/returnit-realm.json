{
  "realm": "returnit",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "loginTheme": "returnit",
  "internationalizationEnabled": true,
  "supportedLocales": ["id", "en", "ar"],
  "defaultLocale": "id",
  "clients": [
    {
      "clientId": "returnit-app",
      "name": "ReturnIt app (DEV ONLY: password grant enabled for tests)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:*",
        "com.returnit.app:/oauth2redirect"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "returnit-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "returnit-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "returnit-worker",
      "name": "ReturnIt worker (deletes erased users; DEV secret, change in production)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-worker-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tester",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-dev-pass",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Tester",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-dev-pass",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-returnit-worker",
      "enabled": true,
      "serviceAccountClientId": "returnit-worker",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}