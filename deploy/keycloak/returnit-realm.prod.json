{
  "realm": "returnit",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "internationalizationEnabled": true,
  "supportedLocales": ["id", "en", "ar"],
  "loginTheme": "returnit",
  "defaultLocale": "id",
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "ReturnIt",
    "auth": "${KC_SMTP_AUTH}",
    "user": "${SMTP_USERNAME}",
    "password": "${SMTP_PASSWORD}",
    "ssl": "${KC_SMTP_SSL}",
    "starttls": "${KC_SMTP_STARTTLS}"
  },
  "clients": [
    {
      "clientId": "returnit-app",
      "name": "ReturnIt mobile app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${MOBILE_REDIRECT_URI}"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "returnit-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "returnit-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "returnit-worker",
      "name": "ReturnIt worker (deletes erased users)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_WORKER_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-returnit-worker",
      "enabled": true,
      "serviceAccountClientId": "returnit-worker",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
