# Production settings. Do NOT edit this file: run ./init.sh, which copies it to .env.prod and fills in the
# __GENERATE__ values with random secrets. Then edit .env.prod (never commit it).
# A value with special characters ($ # spaces quotes) must be wrapped in single quotes: 'my pass'.

# --- Address -------------------------------------------------------------------------------------
# api.<DOMAIN> and auth.<DOMAIN> must both point to this server (DNS A records) before the first start.
# No domain yet? Use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-5.sslip.io (it resolves to the IP).
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Image tag for the app; "local" is built on this server by ./up.sh up -d --build
APP_VERSION=local

# --- Secrets (generated) -------------------------------------------------------------------------
POSTGRES_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
KEYCLOAK_WORKER_SECRET=__GENERATE__
REDIS_PASSWORD=__GENERATE__
S3_ACCESS_KEY=returnit
S3_SECRET_KEY=__GENERATE__
BACKUP_PASSPHRASE=__GENERATE__

# --- Receipt storage -----------------------------------------------------------------------------
# Default: MinIO on this server. For hosted storage (R2, B2...): remove "minio" from COMPOSE_PROFILES
# and set S3_ENDPOINT (host:port, no scheme), S3_USE_SSL=true, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY.
COMPOSE_PROFILES=minio

# --- Virus scanning of uploaded receipts ---------------------------------------------------------
# on  = every upload is scanned by ClamAV (needs about 2 GB of RAM more). Recommended once the server has room.
# off = ClamAV is not started and uploads are NOT scanned. Fine for a small test/pilot server; switch to on
#       later by changing this line and running ./up.sh up -d. Files uploaded while off are never scanned afterwards.
# (Do not list "scan" in COMPOSE_PROFILES yourself; this setting controls it.)
MALWARE_SCAN=on
#S3_ENDPOINT=
#S3_USE_SSL=true
#S3_REGION=auto
#S3_BUCKET=returnit-receipts

# --- Mobile app ----------------------------------------------------------------------------------
# Where the login page sends the user back to the app. Must match the app exactly.
MOBILE_REDIRECT_URI=com.returnit.app:/oauth2redirect

# --- E-mail (verification, password reset, account-deletion notices) ---------------------------
# Use a mail service (Brevo, Resend, Amazon SES...), not this server. SMTP_TLS: starttls (port 587), tls (465) or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- Sign in with Google (optional) --------------------------------------------------------------
# Needs a real domain. After setting these, run ./enable-google.sh (see that file for the Google side).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Push notifications (optional) ---------------------------------------------------------------
# FCM_KEY_FILE is a path on this server, e.g. /opt/returnit/secrets/fcm.json (owner 65532, mode 400).
FCM_PROJECT_ID=
FCM_KEY_FILE=

# --- Backups (see README.md) ---------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=35
# Optional off-site copy: an rclone config file and a destination in it (prefer an encrypted "crypt" remote).
#BACKUP_RCLONE_CONF=/opt/returnit/rclone.conf
#BACKUP_RCLONE_DEST=offsite:returnit-backups
