# Local
.env
*.exe
/bin/

# Production deployment
deploy/.env.prod
deploy/backups/
deploy/secrets/

# Internal documents stay on this computer. Only the mobile developer folder and the API contract are published.
/Docs/*
!/Docs/mobile/
!/Docs/api/
/Docs/api/*
!/Docs/api/openapi.yaml

# Office lock files
~$*

# Published app builds and the app-version settings (written by deploy/publish-apk.sh on the server)
deploy/updates/*
!deploy/updates/.gitkeep
