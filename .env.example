DATABASE_URL=postgres://returnit:returnit_dev@localhost:5432/returnit?sslmode=disable
# debug | info (default) | warn | error
LOG_LEVEL=info
HTTP_ADDR=:8080
OIDC_ISSUER=https://issuer.example.com
OIDC_AUDIENCE=returnit-api
# E-mail (worker): deletion notices. Local dev: docker compose up -d mailpit, then read mail at http://localhost:8025
# SMTP_ADDR=localhost:1025
# SMTP_FROM=noreply@returnit.local
# SMTP_TLS=none            # starttls (default) | tls | none (local dev only, no credentials)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Delete erased users at Keycloak (worker). Needs a client with a service account that has only the
# realm-management role "manage-users". Dev realm: client returnit-worker / secret dev-worker-secret.
# Mobile push (worker): Firebase project id and the path to a service-account key (JSON) that may
# send FCM messages. Both or neither. Without them reminders stay in the in-app inbox.
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
# KEYCLOAK_URL=http://localhost:8180
# KEYCLOAK_REALM=returnit
# KEYCLOAK_ADMIN_CLIENT_ID=returnit-worker
# KEYCLOAK_ADMIN_CLIENT_SECRET=
# Local Keycloak (docker compose --profile auth up -d keycloak): OIDC_ISSUER=http://localhost:8180/realms/returnit
# Deleting an account needs a login at most this old (1m-1h):
# FRESH_LOGIN_MAX_AGE=5m
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
WORKER_CONCURRENCY=10
# Worker health + /metrics (internal only; never publish this port)
WORKER_HEALTH_ADDR=:8081
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=returnit
S3_SECRET_KEY=returnit_dev_secret
S3_BUCKET=returnit-receipts
S3_REGION=us-east-1
S3_USE_SSL=false
# Host used in signed receipt links (what the phone can reach). Leave unset to use S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=files.example.com
# S3_PUBLIC_USE_SSL=true
MAX_RECEIPT_BYTES=10485760
# Malware scanning is ON by default and fails closed. Use MALWARE_SCAN=off only for local development.
# Time between a deletion request and erasure; the user can cancel until then (1h..2160h)
ACCOUNT_DELETION_GRACE=168h
# Rate limits (shared across web instances via Redis). Defaults shown.
RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_ACCOUNT_DELETE_PER_HOUR=3
RATE_LIMIT_UNAUTH_PER_MIN_PER_IP=30
RATE_LIMIT_EXPORT_PER_HOUR=3
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs). Leave empty unless
# the API runs behind one; otherwise a client could spoof its IP.
# TRUSTED_PROXIES=10.0.0.0/8
MALWARE_SCAN=on
CLAMAV_ADDR=localhost:3310
RETENTION_ORPHAN_GRACE=24h
